---
interface Props {
  name: 'phone' | 'arrow' | 'up' | 'pin';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'phone' && <path d="m7.2 3-3.1 1.4c-.7.3-1 1.1-.9 1.8 1.2 7.1 6.7 12.6 13.8 13.8.7.1 1.5-.2 1.8-.9l1.4-3.1-4.5-2.4-1.8 2c-2.5-1.2-4.5-3.2-5.7-5.7l2-1.8L7.2 3Z" />}
  {name === 'arrow' && <path d="M4 12h15M13 5l7 7-7 7" />}
  {name === 'up' && <path d="M12 20V4M5 11l7-7 7 7" />}
  {name === 'pin' && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
</svg>
